                                        <TextBlock Name="WPFUpdRecB2" Text="- Kalite (güvenlik) güncellemelerini 4 gün erteler" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Name="WPFUpdRecB3" Text="- Sürücüleri kalite güncellemelerinden hariç tutar" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Name="WPFUpdRecB4" Text="- İndirilen güncellemeler kuruluma hazır olduğunda bildirir" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Name="WPFUpdRecNote" Text="Windows Pro, Enterprise ve Education sürümlerinde kullanılabilir."
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <Button Name="WPFUpdatessecurity"
                                            Grid.Row="2"
                                            Content="Önerileni Uygula"
                                            FontSize="{DynamicResource ConfigTabButtonFontSize}"
                                            Margin="0,16,0,0"
                                            Padding="10"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource BorderStyle}" Padding="16" MinHeight="300">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                        <TextBlock Name="WPFUpdDefTitle" Text="Windows Varsayılanı"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Name="WPFUpdDefSub" Text="Kontrolü Windows'a geri ver"
                                                   Margin="0,4,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Name="WPFUpdDefB1" Text="- WinUtil tarafından uygulanan güncelleme ilkelerini kaldırır" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Name="WPFUpdDefB2" Text="- Güncelleme hizmeti başlangıç ayarlarını geri yükler" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Name="WPFUpdDefB3" Text="- Zamanlanmış güncelleme görevlerini yeniden etkinleştirir" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Name="WPFUpdDefNote" Text="Önerilen veya Devre Dışı profilini geri almak için bunu kullanın."
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MainForegroundColor}"/>
                                    </StackPanel>
                                    <Button Name="WPFUpdatesdefault"
                                            Grid.Row="2"
                                            Content="Varsayılanlara Dön"
                                            FontSize="{DynamicResource ConfigTabButtonFontSize}"
                                            Margin="0,16,0,0"
                                            Padding="10"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource BorderStyle}" Padding="16" MinHeight="300">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                        <TextBlock Name="WPFUpdDisTitle" Text="Güncellemeleri Kapat"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="Red"/>
                                        <TextBlock Name="WPFUpdDisSub" Text="Yalnızca ileri düzey kullanıcılar için"
                                                   Margin="0,4,0,0"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="Red"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Name="WPFUpdDisB1" Text="- Otomatik güncelleme ilkesini devre dışı bırakır" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Name="WPFUpdDisB2" Text="- Güncelleme hizmetlerini ve zamanlanmış görevleri durdurur" TextWrapping="Wrap" Margin="0,0,0,7" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Name="WPFUpdDisB3" Text="- İndirilmiş güncelleme dosyalarını temizler" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource MainForegroundColor}"/>
                                        <TextBlock Name="WPFUpdDisNote" Text="Bu profil etkinken güvenlik güncellemeleri yüklenmeyecektir."
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Foreground="Red"/>
                                    </StackPanel>
                                    <Button Name="WPFUpdatesdisable"
                                            Grid.Row="2"
                                            Content="Güncellemeleri Kapat"
                                            FontSize="{DynamicResource ConfigTabButtonFontSize}"
                                            Foreground="Red"
                                            Margin="0,16,0,0"
                                            Padding="10"/>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Style="{StaticResource BorderStyle}" Margin="8,14,8,8" Padding="12">
                            <TextBlock Name="WPFUpdFooter" Text="Değişiklikler sistem genelinde uygulanır. Profil değiştirdikten sonra Windows'u yeniden başlatın. WinUtil ilkelerini geri almak için Varsayılanlara Dön seçeneğini kullanın."
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MainForegroundColor}"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Win11ISO" Visibility="Collapsed" Name="WPFTab5">
                <Grid Name="Win11ISOPanel" Margin="{DynamicResource TabContentMargin}" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource BorderStyle}" Padding="20,16">
                        <Grid>
                        <!-- The lopsided weight is what makes the middle column min(available, 620)
                             rather than a third of the card -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1000*" MaxWidth="620"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Name="WPFWin11ISOBackButton"
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Content="&#xE76B;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="{DynamicResource Win11StepTitleFontSize}"
                                MinWidth="44" MinHeight="72"
                                Background="Transparent"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Panel.ZIndex="1"
                                AutomationProperties.Name="Önceki Adım"
                                ToolTip="Önceki adıma dön">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HoverButtonStyle}">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, ElementName=WPFWin11ISOModifySection}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Name="WPFWin11ISOForwardButton"
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                Content="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="{DynamicResource Win11StepTitleFontSize}"
                                MinWidth="44" MinHeight="72"
                                Background="Transparent"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Panel.ZIndex="1"
                                AutomationProperties.Name="Sonraki Adım"
                                ToolTip="Sonraki adıma geç">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HoverButtonStyle}">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, ElementName=WPFWin11ISOSelectSection}" Value="True"/>
                                                <Condition Binding="{Binding IsEnabled, ElementName=WPFWin11ISOModifySection}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TabControl Name="WPFWin11ISOSteps"
                                    Grid.Column="0" Grid.ColumnSpan="3"
                                    Background="Transparent"
                                    BorderThickness="0">
                            <TabControl.Resources>
                                <!-- Text colours: the implicit TextBlock style would paint anything unstyled
                                     cyan on a label background, so every text block here carries a style. -->
                                <Style x:Key="Win11StepHeaderText" TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/>
                                </Style>
                                <Style x:Key="Win11ButtonText" TargetType="TextBlock" BasedOn="{StaticResource Win11StepHeaderText}">
                                    <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}"/>
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                </Style>
                                <Style x:Key="Win11StepIcon" TargetType="TextBlock" BasedOn="{StaticResource Win11StepHeaderText}">
                                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                    <Setter Property="FontSize" Value="{DynamicResource IconFontSize}"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                                <Style x:Key="Win11ButtonIcon" TargetType="TextBlock" BasedOn="{StaticResource Win11ButtonText}">
                                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                    <Setter Property="FontSize" Value="{DynamicResource IconFontSize}"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>

                                <Style TargetType="TabItem">
                                    <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ToggleButtonOffColor}"/>
                                    <Setter Property="HeaderTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Cursor="Hand">
                                                    <TextBlock Style="{StaticResource Win11StepIcon}"
                                                               Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/>
                                                    <TextBlock Style="{StaticResource Win11StepHeaderText}" Text="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border Background="Transparent" Padding="0,0,32,0">
                                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="TabControl">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabControl">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TabPanel Grid.Row="0"
                                                              IsItemsHost="True"
                                                              Background="Transparent"
                                                              Margin="0,0,0,10"/>
                                                    <Border Grid.Row="1"
                                                            BorderBrush="{DynamicResource BorderColor}"
                                                            BorderThickness="0,1,0,0"
                                                            Padding="0,10,0,0">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled">
                                                            <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}">
                                                                <ContentPresenter ContentSource="SelectedContent"/>
                                                            </Grid>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <Style x:Key="Win11StepColumn" TargetType="StackPanel">
                                    <Setter Property="MaxWidth" Value="620"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style x:Key="Win11StepHero" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                    <Setter Property="FontSize" Value="{DynamicResource Win11StepHeroFontSize}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource LabelboxForegroundColor}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,0,14"/>
                                </Style>
                                <Style x:Key="Win11StepTitle" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="{DynamicResource Win11StepTitleFontSize}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource LabelboxForegroundColor}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                </Style>
                                <Style x:Key="Win11StepBody" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                </Style>
                                <Style x:Key="Win11StepSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Win11StepBody}">
                                    <Setter Property="Opacity" Value="0.75"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="MaxWidth" Value="520"/>
                                    <Setter Property="Margin" Value="0,0,0,20"/>
                                </Style>
                                <Style x:Key="Win11StepLabel" TargetType="TextBlock" BasedOn="{StaticResource Win11StepBody}">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource LabelboxForegroundColor}"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                </Style>
                                <Style x:Key="Win11StepValue" TargetType="TextBlock" BasedOn="{StaticResource Win11StepBody}">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                                <Style x:Key="Win11StepCaption" TargetType="TextBlock" BasedOn="{StaticResource Win11StepBody}">
                                    <Setter Property="Opacity" Value="0.75"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>

                                <Style x:Key="Win11StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                    <!-- The implicit style pins Width to ButtonWidth, which clips the longer labels -->
                                    <Setter Property="Width" Value="Auto"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Win11ButtonIcon}"
                                                               Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                                    <TextBlock Style="{StaticResource Win11ButtonText}" Text="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <Style x:Key="Win11InfoPanel" TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundColor}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="5"/>
                                    <Setter Property="Padding" Value="16"/>
                                </Style>
                                <Style x:Key="Win11FormPanel" TargetType="Border" BasedOn="{StaticResource Win11InfoPanel}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource LabelboxForegroundColor}"/>
                                </Style>
                                <Style x:Key="Win11SummaryIcon" TargetType="TextBlock" BasedOn="{StaticResource Win11StepIcon}">
                                    <Setter Property="Foreground" Value="{DynamicResource LabelboxForegroundColor}"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="Margin" Value="0,1,12,0"/>
                                </Style>
                                <Style x:Key="Win11SummaryRow" TargetType="StackPanel">
                                    <Setter Property="Orientation" Value="Horizontal"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                </Style>
                            </TabControl.Resources>

                            <!-- === STEP 1 : Select Windows 11 ISO =============== -->
                            <TabItem Name="WPFWin11ISOSelectSection" Tag="&#xE958;" Header="1   ISO Seç">
                                <StackPanel Style="{StaticResource Win11StepColumn}">
                                    <TextBlock Text="&#xE958;" Style="{StaticResource Win11StepHero}"/>
                                    <TextBlock Name="WPFWin11Step1Title" Style="{StaticResource Win11StepTitle}" Text="Windows 11 ISO dosyanızı seçin"/>
                                    <TextBlock Name="WPFWin11Step1Sub" Style="{StaticResource Win11StepSubtitle}" Text="Microsoft'tan indirilen resmi bir Windows 11 ISO dosyası seçin. Herhangi bir değişiklik yapılmadan önce bağlanıp doğrulanacaktır."/>

                                    <Border Style="{StaticResource Win11FormPanel}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Name="WPFWin11IsoFileLabel" Style="{StaticResource Win11StepLabel}" Text="ISO dosyası"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Name="WPFWin11ISOPath"
                                                         AutomationProperties.Name="ISO dosyası"
                                                         IsReadOnly="True"
                                                         VerticalAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         Height="34"
                                                         Padding="10,0"
                                                         Margin="0,0,12,0"
                                                         Text="ISO seçilmedi..."
                                                         Foreground="{DynamicResource MainForegroundColor}"
                                                         Background="{DynamicResource MainBackgroundColor}"/>
                                                <Button Grid.Column="1" Name="WPFWin11ISOBrowseButton" MinWidth="130"
                                                        Style="{StaticResource Win11StepButton}" Tag="&#xE8B7;" Content="Gözat"/>
                                            </Grid>
                                            <!-- Hidden rather than collapsed so picking an ISO does not shift the page -->
                                            <TextBlock Name="WPFWin11ISOFileInfo"
                                                       Style="{StaticResource Win11StepBody}"
                                                       Margin="0,10,0,0"
                                                       Visibility="Hidden"
                                                       Text="Dosya boyutu:"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Name="WPFWin11ISOMountButton" Margin="0,0,0,20"
                                            Style="{StaticResource Win11StepButton}" Tag="&#xE8FB;" Content="ISO'yu Bağla ve Doğrula"/>

                                    <Border Style="{StaticResource Win11InfoPanel}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Win11StepLabel}" Foreground="OrangeRed" Margin="0,0,0,10">
                                                <Run FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;"/>
                                                <Run Name="WPFWin11OfficialWarn" Text=" Resmi bir Microsoft ISO dosyası kullanmalısınız"/>
                                            </TextBlock>
                                            <TextBlock Name="WPFWin11OfficialBody1" Style="{StaticResource Win11StepBody}" Text="Üçüncü taraf, önceden düzenlenmiş veya resmi olmayan kalıplar desteklenmez ve hatalı sonuçlara yol açabilir. Bu araç yalnızca temiz ve yeni Windows kurulumları içindir."/>
                                            <TextBlock Name="WPFWin11OfficialBody2" Style="{StaticResource Win11StepBody}" Margin="0,0,0,12" Text="İndirme sayfasında Windows 11, dilinizi ve 64-bit (x64) seçeneğini seçin."/>
                                            <Button Name="WPFWin11ISODownloadLink"
                                                    Style="{StaticResource Win11StepButton}" Tag="&#xE8A7;" Content="Microsoft İndirme Sayfasını Aç"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>

                            <!-- === STEP 2 : Modify install.wim ===================== -->
                            <TabItem Name="WPFWin11ISOModifySection" IsEnabled="False" Tag="&#xE713;" Header="2   Kalıbı Düzenle">
                                <StackPanel Style="{StaticResource Win11StepColumn}">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource Win11StepHero}"/>
                                    <TextBlock Name="WPFWin11Step2Title" Style="{StaticResource Win11StepTitle}" Text="Kalıbı düzenle"/>
                                    <TextBlock Name="WPFWin11Step2Sub" Style="{StaticResource Win11StepSubtitle}" Text="Kalıba dahil edilecek seçenekleri belirleyin ve başlatın. Bu işlem donanımınıza bağlı olarak birkaç dakika sürer."/>

                                    <Border Name="WPFWin11ISOVerifyResultPanel"
                                            Style="{StaticResource Win11InfoPanel}"
                                            Padding="14,10"
                                            Margin="0,0,0,14"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="&#xE8FB;" Style="{StaticResource Win11SummaryIcon}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="&#xE958;" Style="{StaticResource Win11StepIcon}"/>
                                                <TextBlock Name="WPFWin11MountedAt" Style="{StaticResource Win11StepCaption}" Text="Bağlı sürücü"/>
                                                <TextBlock Name="WPFWin11ISOMountDriveLetter" Style="{StaticResource Win11StepValue}"/>
                                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Win11StepIcon}" Margin="22,0,8,0"/>
                                                <TextBlock Name="WPFWin11ImageFile" Style="{StaticResource Win11StepCaption}" Text="Kalıp dosyası"/>
                                                <TextBlock Name="WPFWin11ISOImageFile" Style="{StaticResource Win11StepValue}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource Win11FormPanel}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Name="WPFWin11EditionLabel" Style="{StaticResource Win11StepLabel}" Text="Windows sürümü"/>
                                            <ComboBox Name="WPFWin11ISOEditionComboBox"
                                                      AutomationProperties.Name="Windows sürümü"
                                                      FontSize="{DynamicResource FontSize}"
                                                      Foreground="{DynamicResource MainForegroundColor}"
                                                      Background="{DynamicResource MainBackgroundColor}"
                                                      HorizontalAlignment="Stretch"
                                                      Height="34"
                                                      Margin="0,0,0,14"/>
                                            <CheckBox Name="WPFWin11ISOInjectDrivers"
                                                      Content="Mevcut sistem sürücülerini entegre et"
                                                      FontSize="{DynamicResource FontSize}"
                                                      Foreground="{DynamicResource MainForegroundColor}"
                                                      IsChecked="False"
                                                      Cursor="Hand"
                                                      ToolTip="Kurulum için depolama sürücülerini ekler ve mevcut sistemden dışa aktarılan sürücüleri seçili install.wim sürümüne tek tek entegre ederek uyumsuz paketleri atlar."/>
                                        </StackPanel>
                                    </Border>

                                    <Button Name="WPFWin11ISOModifyButton" Margin="0,0,0,20"
                                            Style="{StaticResource Win11StepButton}" Tag="&#xE768;"
                                            Content="Windows ISO Düzenleme ve Oluşturmayı Başlat"/>

                                    <Border Style="{StaticResource Win11InfoPanel}">
                                        <StackPanel>
                                            <TextBlock Name="WPFWin11WhatItDoes" Style="{StaticResource Win11StepLabel}" Margin="0,0,0,12" Text="Bu işlem kalıpta neler yapar?"/>
                                            <StackPanel Style="{StaticResource Win11SummaryRow}">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Win11SummaryIcon}"/>
                                                <TextBlock Name="WPFWin11Does1" Style="{StaticResource Win11StepBody}" Margin="0"
                                                           Text="Önceden yüklü gereksiz uygulamaları ve OneDrive kurulumunu kaldırır"/>
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Win11SummaryRow}">
                                                <TextBlock Text="&#xE950;" Style="{StaticResource Win11SummaryIcon}"/>
                                                <TextBlock Name="WPFWin11Does2" Style="{StaticResource Win11StepBody}" Margin="0"
                                                           Text="TPM, Secure Boot, CPU, RAM ve depolama gereksinim kontrollerini atlar"/>
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Win11SummaryRow}">
                                                <TextBlock Text="&#xE77B;" Style="{StaticResource Win11SummaryIcon}"/>
                                                <TextBlock Name="WPFWin11Does3" Style="{StaticResource Win11StepBody}" Margin="0"
                                                           Text="Yerel hesap kullanabilmeniz için Microsoft hesabı ekranını atlar"/>
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Win11SummaryRow}">
                                                <TextBlock Text="&#xE7EE;" Style="{StaticResource Win11SummaryIcon}"/>
                                                <TextBlock Name="WPFWin11Does4" Style="{StaticResource Win11StepBody}" Margin="0"
                                                           Text="Telemetri, Copilot, sohbet simgesi ve arama kutusu önerilerini kapatır"/>
                                            </StackPanel>
                                            <StackPanel Style="{StaticResource Win11SummaryRow}" Margin="0">
                                                <TextBlock Text="&#xE8EF;" Style="{StaticResource Win11SummaryIcon}"/>
                                                <TextBlock Name="WPFWin11Does5" Style="{StaticResource Win11StepBody}" Margin="0"
                                                           Text="Kurulumun başka bir sürüm seçmemesi için yukarıda seçtiğiniz sürümü sabitler"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>

                            <!-- === STEP 3 : Output Options ========================= -->
                            <TabItem Name="WPFWin11ISOOutputSection" IsEnabled="False" Tag="&#xE88E;" Header="3   Çıktı">
                                <StackPanel Style="{StaticResource Win11StepColumn}">
                                    <TextBlock Text="&#xE88E;" Style="{StaticResource Win11StepHero}"/>
                                    <TextBlock Name="WPFWin11Step3Title" Style="{StaticResource Win11StepTitle}" Text="Kalıbınız hazır"/>
                                    <TextBlock Name="WPFWin11Step3Sub" Style="{StaticResource Win11StepSubtitle}" Text="Düzenlenmiş kalıbı bir ISO dosyası olarak kaydedin veya doğrudan önyüklenebilir bir USB belleğe yazın."/>

                                    <Border Name="WPFWin11ISODonePanel"
                                            Style="{StaticResource Win11InfoPanel}"
                                            Padding="14,10"
                                            Margin="0,0,0,14"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8FB;" Style="{StaticResource Win11SummaryIcon}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Name="WPFWin11ISODoneLabel" Style="{StaticResource Win11StepValue}"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Name="WPFWin11ISOChooseISOButton" Margin="0,0,0,10"
                                            Style="{StaticResource Win11StepButton}" Tag="&#xE74E;" Content="ISO Dosyası Olarak Kaydet"/>
                                    <Button Name="WPFWin11ISOChooseUSBButton" Foreground="OrangeRed"
                                            Style="{StaticResource Win11StepButton}" Tag="&#xE88E;"
                                            Content="Doğrudan USB Belleğe Yaz (SÜRÜCÜYÜ SİLER)"/>

                                    <Border Name="WPFWin11ISOOptionUSB"
                                            Style="{StaticResource Win11FormPanel}"
                                            Visibility="Collapsed"
                                            Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Win11StepBody}">
                                                <Run Name="WPFWin11UsbWarn" FontWeight="Bold" Foreground="OrangeRed" Text="!! Seçilen USB bellekteki tüm veriler kalıcı olarak silinecektir !!"/>
                                            </TextBlock>
                                            <TextBlock Name="WPFWin11UsbDriveLabel" Style="{StaticResource Win11StepLabel}" Text="USB sürücü"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          Name="WPFWin11ISOUSBDriveComboBox"
                                                          AutomationProperties.Name="USB sürücü"
                                                          Foreground="{DynamicResource MainForegroundColor}"
                                                          Background="{DynamicResource MainBackgroundColor}"
                                                          VerticalAlignment="Center"
                                                          Height="34"
                                                          Margin="0,0,12,0"/>
                                                <Button Grid.Column="1" Name="WPFWin11ISORefreshUSBButton" MinWidth="130"
                                                        Style="{StaticResource Win11StepButton}" Tag="&#xE895;" Content="Yenile"/>
                                            </Grid>
                                            <Button Name="WPFWin11ISOWriteUSBButton" Foreground="OrangeRed"
                                                    Style="{StaticResource Win11StepButton}" Tag="&#xE7BA;" Content="Sil ve USB'ye Yaz"/>
                                        </StackPanel>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                                            Margin="0,20,0,0" Padding="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Name="WPFWin11ResetSub" Style="{StaticResource Win11StepSubtitle}" Margin="0,0,0,10"
                                                       Text="Bu kalıpla işiniz bitti mi? Geçici dosyaları temizleyip 1. adımdan yeniden başlayın."/>
                                            <Button Name="WPFWin11ISOCleanResetButton"
                                                    HorizontalAlignment="Center" MinWidth="240"
                                                    Style="{StaticResource Win11StepButton}" Tag="&#xE72C;" Content="Baştan Başla"
                                                    ToolTip="Geçici çalışma klasörünü siler ve ilk adıma döner"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>

                            <!-- === Working page: selected while a step runs, no header of its own === -->
                            <TabItem Name="WPFWin11ISOWorkingSection" Visibility="Collapsed">
                                <StackPanel Style="{StaticResource Win11StepColumn}">
                                    <!-- BitmapCache because this is text: without it WPF re-rasterises the
                                         glyph every frame on the interface thread and the spin stutters.
                                         Cached, the rotation is a transform on an image the GPU already has. -->
                                    <TextBlock Name="WPFWin11ISOWorkingSpinner"
                                               Text="&#xE895;"
                                               Tag="Forward"
                                               RenderTransformOrigin="0.5,0.5"
                                               CacheMode="BitmapCache">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Win11StepHero}">
                                                <Style.Triggers>
                                                    <!-- Tied to visibility, not to Loaded: the working page stays loaded
                                                         while collapsed, so a Loaded trigger left it spinning forever -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Forward"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard Name="Win11ISOSpin">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                        From="0" To="360" Duration="0:0:1.4"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                        <MultiDataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="Win11ISOSpin"/>
                                                        </MultiDataTrigger.ExitActions>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Reverse"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard Name="Win11ISOSpinReverse">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                        From="360" To="0" Duration="0:0:1.4"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                        <MultiDataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="Win11ISOSpinReverse"/>
                                                        </MultiDataTrigger.ExitActions>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Name="WPFWin11ISOWorkingLabel"
                                               Style="{StaticResource Win11StepTitle}"
                                               Text="İşleniyor..."/>
                                    <TextBlock Name="WPFWin11WorkingSub" Style="{StaticResource Win11StepSubtitle}"
                                               Margin="0"
                                               Text="Bu işlem birkaç dakika sürebilir. İlerleme durum günlüğüne yazılmaktadır."/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                        </Grid>
                    </Border>

                    <!-- === Status log === -->
                    <Border Grid.Column="1" Style="{StaticResource BorderStyle}" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource IconFontSize}"
                                           Background="Transparent"
                                           Foreground="{DynamicResource LabelboxForegroundColor}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Name="WPFWin11StatusLogTitle" FontSize="{DynamicResource FontSize}"
                                           FontWeight="Bold"
                                           Background="Transparent"
                                           Foreground="{DynamicResource LabelboxForegroundColor}"
                                           VerticalAlignment="Center"
                                           Text="Durum Günlüğü"/>
                            </StackPanel>
                            <Border Grid.Row="1"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,10,0,0">
                                <!-- TextAlignment and Effect look redundant but are not: the shared TextBox
                                     style stretches content alignment, which WPF renders as justified once
                                     text wraps, and its drop shadow lands on the glyphs with no background
                                     here to sit under. -->
                                <TextBox Name="WPFWin11ISOStatusLog"
                                         AutomationProperties.Name="Durum Günlüğü"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         TextAlignment="Left"
                                         FontFamily="{DynamicResource Win11LogFontFamily}"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalAlignment="Stretch"
                                         Padding="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource MainForegroundColor}"
                                         BorderThickness="0"
                                         Effect="{x:Null}"
                                         Text="Hazır. Başlamak için lütfen bir Windows 11 ISO dosyası seçin."/>
                            </Border>
                        </Grid>
                    </Border>

                </Grid>
            </TabItem>
            <TabItem Header="AppX" Visibility="Collapsed" Name="WPFTab6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="0" Margin="{DynamicResource TabContentMargin}">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Background="Transparent" Orientation="Vertical" Grid.Row="0" Grid.Column="0" Margin="5">
                                <Label Name="WPFAppxSelectionsLabel" Content="Seçimler:" FontSize="{DynamicResource FontSize}" VerticalAlignment="Center" Margin="2"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2,0,0">
                                    <Button Name="WPFDefaultAppxSelection" Content=" Varsayılan " Margin="2" Width="{DynamicResource ButtonWidth}" Height="{DynamicResource ButtonHeight}"/>
                                    <Button Name="WPFGetInstalledAppx" Content=" Yüklü Olanları Seç " Margin="2" Width="{DynamicResource ButtonWidth}" Height="{DynamicResource ButtonHeight}"/>
                                    <Button Name="WPFSelectAllAppx" Content=" Tümünü Seç " Margin="2" Width="{DynamicResource ButtonWidth}" Height="{DynamicResource ButtonHeight}"/>
                                    <Button Name="WPFClearAppxSelection" Content=" Seçimi Temizle " Margin="2" Width="{DynamicResource ButtonWidth}" Height="{DynamicResource ButtonHeight}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Name="appxpanel" Grid.Row="1">
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource BorderStyle}" Margin="5,15,5,5">
                                <WrapPanel Background="Transparent" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Padding="10" TextWrapping="Wrap" Foreground="{DynamicResource MainForegroundColor}">
                                        <Run Name="WPFAppxNote1" Text="Not: Kurmak veya kaldırmak istediğiniz Windows AppX paketlerini seçin."/>
                                        <LineBreak/><Run Name="WPFAppxNote2" Text="'Seçilileri Kur' mevcut olduğunda yerel bildirimi kaydeder, yoksa Microsoft Store'a yönlendirir."/>
                                        <LineBreak/><Run Name="WPFAppxNote3" Text="'Seçilileri Kaldır' paketleri tüm kullanıcılar için kaldırır ve yeni kullanıcı profillerine otomatik kurulmasını engeller."/>
                                    </TextBlock>
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="5" HorizontalAlignment="Stretch" Padding="10">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Name="WPFBackToTweaks" Content="İnce Ayarlara Dön" Margin="5" Width="{DynamicResource ButtonWidth}" Height="{DynamicResource ButtonHeight}"/>
                            <Button Name="WPFInstallSelectedAppx" Content="Seçilileri Kur" Margin="5" Width="{DynamicResource ButtonWidth}" Height="{DynamicResource ButtonHeight}"/>
                            <Button Name="WPFRemoveSelectedAppx" Content="Seçilileri Kaldır" Margin="5" Width="{DynamicResource ButtonWidth}" Height="{DynamicResource ButtonHeight}"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="SystemHealth" Visibility="Collapsed" Name="WPFTab7">
                <Grid MaxWidth="1320" HorizontalAlignment="Stretch" Margin="{DynamicResource TabContentMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header + 4 Sub-Tab Pill Buttons -->
                    <Border Grid.Row="0" Style="{StaticResource BorderStyle}" Padding="12,10" Margin="4,2,4,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <Button Name="WPFSysRefreshBtn" DockPanel.Dock="Right" Content="Yenile" Width="110" Height="28" Padding="8,2"/>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Name="WPFSysDashTitle" Text="Sistem Özeti ve Bakım Merkezi" FontSize="18" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                    <TextBlock Name="WPFSysDashSubtitle" Text="Wintoys tarzı canlı donanım özeti, performans hızlandırma, derin temizlik, ağ/DNS ve başlangıç yönetimi" FontSize="12" Opacity="0.8" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <ToggleButton Name="WPFSysSubBtnOverview" Content="Özet &amp; Donanım" IsChecked="True" Style="{StaticResource FilterChipToggleStyle}" Padding="16,5" Margin="0,0,6,0"/>
                                <ToggleButton Name="WPFSysSubBtnBoost" Content="Performans &amp; Oyun" IsChecked="False" Style="{StaticResource FilterChipToggleStyle}" Padding="16,5" Margin="0,0,6,0"/>
                                <ToggleButton Name="WPFSysSubBtnClean" Content="Temizlik &amp; Ağ" IsChecked="False" Style="{StaticResource FilterChipToggleStyle}" Padding="16,5" Margin="0,0,6,0"/>
                                <ToggleButton Name="WPFSysSubBtnStartup" Content="Başlangıç &amp; Ayarlar" IsChecked="False" Style="{StaticResource FilterChipToggleStyle}" Padding="16,5" Margin="0,0,6,0"/>
                                <ToggleButton Name="WPFSysSubBtnApps" Content="Yüklü Programlar" IsChecked="False" Style="{StaticResource FilterChipToggleStyle}" Padding="16,5" Margin="0"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: Scrollable Sub-Tab Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,0,4">
                            <!-- ================= SUB-TAB 1: OVERVIEW & HARDWARE ================= -->
                            <Grid Name="WPFSysPanelOverview" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top 5 Live Hardware Cards -->
                                <Border Grid.Row="0" Style="{StaticResource BorderStyle}" Padding="10" Margin="4,0,4,6">
                                    <UniformGrid Columns="5">
                                        <Border Background="{DynamicResource MainBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Name="WPFSysTileOsLabel" Text="İşletim Sistemi" FontSize="11" Opacity="0.7" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                <TextBlock Name="WPFSysValOs" Text="Yükleniyor..." FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                <TextBlock Name="WPFSysValUptime" Text="" FontSize="11" Opacity="0.75" Margin="0,2,0,0" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource MainBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                                            <StackPanel>
                                                <TextBlock Name="WPFSysTileCpuLabel" Text="İşlemci (CPU)" FontSize="11" Opacity="0.7" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                <TextBlock Name="WPFSysValCpu" Text="Yükleniyor..." FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                <TextBlock Name="WPFSysValCpuSub" Text="" FontSize="11" Opacity="0.75" Margin="0,2,0,0" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource MainBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                                            <StackPanel>
                                                <TextBlock Name="WPFSysTileRamLabel" Text="Bellek (RAM)" FontSize="11" Opacity="0.7" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                <TextBlock Name="WPFSysValRam" Text="Yükleniyor..." FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                <TextBlock Name="WPFSysValRamSub" Text="" FontSize="11" Opacity="0.75" Margin="0,2,0,0" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource MainBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                                            <StackPanel>
                                                <TextBlock Name="WPFSysTileGpuLabel" Text="Ekran Kartı (GPU)" FontSize="11" Opacity="0.7" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                <TextBlock Name="WPFSysValGpu" Text="Yükleniyor..." FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                <TextBlock Name="WPFSysValGpuSub" Text="" FontSize="11" Opacity="0.75" Margin="0,2,0,0" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource MainBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Name="WPFSysTileDiskLabel" Text="Sistem Diski (C:)" FontSize="11" Opacity="0.7" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                <TextBlock Name="WPFSysValDisk" Text="Yükleniyor..." FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                <TextBlock Name="WPFSysValDiskSub" Text="" FontSize="11" Opacity="0.75" Margin="0,2,0,0" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Border>

                                <!-- Bottom 2-Column Detailed Diagnostics -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Battery Health + System Identity/BIOS/License -->
                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource BorderStyle}" Padding="12" Margin="4,0,4,6">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <Button Name="WPFSysBtnBatteryReport" DockPanel.Dock="Right" Content="HTML Pil Raporu" Width="Auto" Height="26" Padding="10,2" ToolTip="powercfg /batteryreport çalıştırıp ayrıntılı pil raporunu tarayıcıda açar."/>
                                                    <TextBlock Name="WPFSysBatteryTitle" Text="Pil Sağlığı ve Güç Durumu" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                </DockPanel>
                                                <Border Background="{DynamicResource MainBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10">
                                                    <StackPanel>
                                                        <TextBlock Name="WPFSysValBatteryHealth" Text="Taranıyor..." FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                        <TextBlock Name="WPFSysValBatterySub" Text="" FontSize="11.5" Opacity="0.8" TextWrapping="Wrap" Margin="0,3,0,0" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                        <TextBlock Name="WPFSysValPowerNow" Text="" FontSize="11.5" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource BorderStyle}" Padding="12" Margin="4,0,4,0">
                                            <StackPanel>
                                                <TextBlock Name="WPFSysIdentityTitle" Text="Sistem Kimliği, BIOS ve Lisans" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                <Border Background="{DynamicResource MainBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="145"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Name="WPFSysLblBoard" Grid.Row="0" Grid.Column="0" Text="Anakart:" FontSize="12" Opacity="0.75" Margin="0,2" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                        <TextBlock Name="WPFSysValBoard" Grid.Row="0" Grid.Column="1" Text="-" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                        <TextBlock Name="WPFSysLblBios" Grid.Row="1" Grid.Column="0" Text="BIOS / UEFI:" FontSize="12" Opacity="0.75" Margin="0,2" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                        <TextBlock Name="WPFSysValBios" Grid.Row="1" Grid.Column="1" Text="-" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                        <TextBlock Name="WPFSysLblSecurity" Grid.Row="2" Grid.Column="0" Text="Güvenlik (TPM/SB):" FontSize="12" Opacity="0.75" Margin="0,2" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                        <TextBlock Name="WPFSysValSecurity" Grid.Row="2" Grid.Column="1" Text="-" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                        <TextBlock Name="WPFSysLblLicense" Grid.Row="3" Grid.Column="0" Text="Windows Lisansı:" FontSize="12" Opacity="0.75" Margin="0,2" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                        <TextBlock Name="WPFSysValLicense" Grid.Row="3" Grid.Column="1" Text="-" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" Background="Transparent" Foreground="{DynamicResource MainForegroundColor}"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right: All Drives + Physical Disk S.M.A.R.T. Health -->
                                    <Border Grid.Column="1" Style="{StaticResource BorderStyle}" Padding="12" Margin="4,0,4,0">
